{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@thiepcuoi/schema": ["../../packages/schema/src/index.ts"],
      "@thiepcuoi/runtime": ["../../packages/runtime/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
