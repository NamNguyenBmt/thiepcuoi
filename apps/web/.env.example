# Chép thành .env.local (dev) hoặc đặt trong bảng biến môi trường của hosting.
# Ở production, thiếu DATABASE_URL hoặc S3_* là app từ chối khởi động — cố ý.

# ─── Database ───────────────────────────────────────────────
# Bỏ trống ở dev = dùng PGlite nhúng (.data/pg). Production thì bắt buộc.
DATABASE_URL=postgres://user:pass@host:5432/thiepcuoi
# Đặt 1 nếu DATABASE_URL trỏ tới PGlite dạng server socket
# PG_POOL_MAX=10

# ─── Kho ảnh (S3 / Cloudflare R2) ───────────────────────────
# Bỏ trống ở dev = ghi vào .data/uploads. Production thì bắt buộc, vì ổ đĩa của
# hosting thường bị xoá sau mỗi lần deploy.
S3_BUCKET=thiepcuoi-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# true cho MinIO và phần lớn S3 tự host, false cho R2 và AWS
S3_FORCE_PATH_STYLE=false

# ─── Tài khoản khởi tạo ─────────────────────────────────────
# Bỏ trống thì hệ thống sinh mật khẩu ngẫu nhiên và in ra log server một lần.
SEED_EMAIL=admin@thiepcuoi.local
# SEED_PASSWORD=

# ─── Captcha đăng ký ─────────────────────────────────────────
# Bỏ trống = mỗi tiến trình tự sinh secret riêng (đủ cho dev/một instance).
# Chạy nhiều instance thì đặt để chúng xác minh được token của nhau.
# CAPTCHA_SECRET=

# ─── Đường dẫn ──────────────────────────────────────────────
# Nơi editor được phục vụ (dev là cổng 5173)
NEXT_PUBLIC_EDITOR_URL=http://localhost:5173
# Đặt nếu ảnh đi qua CDN thay vì qua chính app
# NEXT_PUBLIC_ASSET_BASE=https://cdn.example.com
